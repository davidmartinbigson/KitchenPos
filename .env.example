# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Used by docker-compose for the postgres container
DB_PASSWORD=postgres

# ── Security (CHANGE these in production!) ────────────────
SESSION_SECRET=change-this-to-a-long-random-string
# true when serving over HTTPS (after SSL is set up)
COOKIE_SECURE=false

# ── Master admin (created automatically on first login) ───
MASTER_ADMIN_EMAIL=davidmartinbigson@gmail.com
MASTER_ADMIN_PASSWORD=ShAyAnAlI!123#

# ── Server ────────────────────────────────────────────────
PORT=3000

# ── Password reset emails (optional) ──────────────────────
# If SMTP is not configured, reset links are shown on screen instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Kitchen POS <you@gmail.com>
